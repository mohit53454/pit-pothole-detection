<?xml version="1.0" encoding="utf-8"?>
<!-- PIT mark: two road edges converging in perspective with one bold crater set
     into the surface. Single weight, no gradients, no centre dash - the fewer
     elements, the better it reads at 24dp in the header and at launcher size. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- left road edge -->
    <path
        android:pathData="M8,2.6 L4.6,21.4"
        android:strokeColor="@color/ink"
        android:strokeWidth="1.9"
        android:strokeLineCap="round" />

    <!-- right road edge -->
    <path
        android:pathData="M16,2.6 L19.4,21.4"
        android:strokeColor="@color/ink"
        android:strokeWidth="1.9"
        android:strokeLineCap="round" />

    <!-- the crater, drawn as a perspective ellipse -->
    <path
        android:pathData="M7.4,15 a4.6,2.6 0 1,0 9.2,0 a4.6,2.6 0 1,0 -9.2,0"
        android:fillColor="@color/ink" />
</vector>
